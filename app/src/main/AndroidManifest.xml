<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.larus.nova" />
        <package android:name="com.obric.aiagent.plugin" />
    </queries>
    <application android:label="@string/app_name"
        android:icon="@drawable/ic_lab" android:theme="@style/AppTheme"
        android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <meta-data android:name="com.obric.agentrobots.POLICY_JSON"
            android:resource="@raw/agent_saep_policy" />
        <receiver android:name=".SecurityHarnessReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity android:name=".SecurityActivity" android:exported="false" />
        <activity android:name=".ReadOpenActivity" android:exported="false" />
        <activity android:name=".ReadSaepActivity" android:exported="false" />
        <activity android:name=".ReadSecureActivity" android:exported="false" />
        <activity android:name=".ReadBothActivity" android:exported="false" />
        <activity android:name=".IntentRecordActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".LogsActivity" android:exported="false" />
        <activity android:name=".CapabilitiesActivity" android:exported="false" />
        <activity android:name=".CapabilityTaskActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RestrictedInputActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".NotesActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DiagnosisActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
